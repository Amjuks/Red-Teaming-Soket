{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OWASP benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "run",
    "progress",
    "coverage",
    "metrics",
    "findings",
    "limitations",
    "artifacts",
    "breakdowns",
    "assessment",
    "configuration",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "benchmark": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "enum": [
            "llm02",
            "llm06",
            "llm10"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "model",
        "execution_state",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "model": {
          "type": "object"
        },
        "execution_state": {
          "enum": [
            "partial",
            "finished"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": [
        "unit",
        "planned",
        "completed",
        "errored",
        "skipped",
        "pending"
      ],
      "properties": {
        "unit": {
          "enum": [
            "test",
            "scenario_variant",
            "workload_call"
          ]
        },
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "errored": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "counts",
          "details"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "counts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "unit",
                "numerator",
                "denominator",
                "population",
                "missing_reasons",
                "notes"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "numerator": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "denominator": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "population": {
                  "type": "string"
                },
                "missing_reasons": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "numerator",
          "denominator",
          "population",
          "missing_reasons",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "numerator": {
            "type": [
              "number",
              "null"
            ]
          },
          "denominator": {
            "type": [
              "number",
              "null"
            ]
          },
          "population": {
            "type": "string"
          },
          "missing_reasons": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "severity",
          "evidence",
          "details",
          "observation",
          "impact",
          "recommendation",
          "retest",
          "severity_reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "details": {
            "type": "object"
          },
          "observation": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "retest": {
            "type": "string"
          },
          "severity_reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "media_type",
          "sensitivity"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "breakdowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "group",
          "metrics"
        ],
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "unit",
                "numerator",
                "denominator",
                "population",
                "missing_reasons",
                "notes"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "numerator": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "denominator": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "population": {
                  "type": "string"
                },
                "missing_reasons": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "assessed",
        "unassessed",
        "population",
        "judge",
        "missing_reasons"
      ],
      "properties": {
        "verdict": {
          "type": "string"
        },
        "assessed": {
          "type": [
            "number",
            "null"
          ]
        },
        "unassessed": {
          "type": [
            "number",
            "null"
          ]
        },
        "population": {
          "type": "string"
        },
        "judge": {
          "type": [
            "object",
            "null"
          ]
        },
        "missing_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "configuration": {
      "type": "object"
    },
    "extensions": {
      "type": "object",
      "required": [
        "metrics",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "object"
        },
        "coverage": {
          "type": "object"
        }
      }
    },
    "failure_export": {
      "type": "object"
    }
  }
}
