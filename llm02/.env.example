# DEFAULT LIVE MODE USES LOOP: no .env or new endpoint key is required.
# The variables below are only for the optional standalone OpenAI-compatible mode.
# Never commit real credentials.
LLM_BASE_URL=https://your-endpoint.example/v1
LLM_MODEL=your-model
LLM_API_KEY=
# Optional separate semantic judge. May use the same endpoint/model.
JUDGE_BASE_URL=https://your-endpoint.example/v1
JUDGE_MODEL=your-judge-model
JUDGE_API_KEY=
# Optional for gated Hugging Face data.
HF_TOKEN=
